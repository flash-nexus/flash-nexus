{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@flash-nexus/config": ["./packages/config/src/index.ts"],
      "@flash-nexus/core": ["./packages/core/src/index.ts"],
      "@flash-nexus/sdk": ["./packages/sdk/src/index.ts"],
      "@flash-nexus/types": ["./packages/types/src/index.ts"]
    },
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "eslint.config.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
